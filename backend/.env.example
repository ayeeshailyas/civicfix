# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Vision-capable model currently available on OpenRouter's free tier.
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_FREE_FALLBACK_MODELS=nvidia/nemotron-nano-12b-v2-vl:free

# Shown to OpenRouter for their leaderboards, optional but recommended
OPENROUTER_SITE_URL=http://localhost:5000
OPENROUTER_APP_NAME=CivicFix

# Port the server runs on
PORT=5000
