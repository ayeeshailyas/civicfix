# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Vision-capable model on OpenRouter. Both of these work well:
# google/gemini-2.5-flash  (recommended - fast + strong vision)
# qwen/qwen2.5-vl-72b-instruct  (Qwen's vision model - note: use the VL/vision variant, not plain 2.5-72b-instruct which is text-only)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Shown to OpenRouter for their leaderboards, optional but recommended
OPENROUTER_SITE_URL=http://localhost:5000
OPENROUTER_APP_NAME=CivicFix

# Port the server runs on
PORT=5000
